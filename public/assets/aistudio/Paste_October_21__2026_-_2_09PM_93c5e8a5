  }
  var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SR){ snack('⚠️ Browser tidak mendukung input suara.'); return; }
  trRec = new SR();
  trRec.lang = trDir==='id2zh' ? 'id-ID' : 'zh-CN';
  trRec.interimResults = false;
  trRec.continuous = false;
  trRec.onstart = function(){ trRecording = true; document.getElementById('trMk').classList.add('rec'); snack('🎤 Mendengarkan…'); };
  trRec.onresult = function(e){ document.getElementById('trIn').value = e.results[0][0].transcript; upCC(); snack('✓ Suara tertangkap'); };
  trRec.onerror = function(e){ if(e.error==='not-allowed') snack('❌ Izin mikrofon ditolak.'); else snack('⚠️ Error: '+e.error); };
  trRec.onend = function(){ trRecording = false; document.getElementById('trMk').classList.remove('rec'); };
  try{ trRec.start(); }catch(e){ snack('⚠️ Tidak bisa memulai mikrofon'); }
}

/* ============ KEYBOARD ============ */
document.addEventListener('keydown', function(e){
  var isInput = (e.target.tagName==='INPUT' || e.target.tagName==='TEXTAREA');
  var trOpen = document.getElementById('trOv').classList.contains('on');
  if(e.key==='Escape' && trOpen){ closeTR(); return; }
  if(isInput) return;
  if(e.key==='ArrowRight') nextPg();
  if(e.key==='ArrowLeft') prevPg();
});

/* ============ INIT ============ */
(function init(){
  try{
    var saved = parseInt(localStorage.getItem('mandarin_page'));
    if(saved>=1 && saved<=TOTAL) currentPage = saved;
  }catch(e){}
  renderToc();
  renderPage();
  updateNav();
  updateProgress();
  if('speechSynthesis' in window){
    window.speechSynthesis.getVoices();
    setTimeout(loadVoices, 300);
  }
})();
</script>

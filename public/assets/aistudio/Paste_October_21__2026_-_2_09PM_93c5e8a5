}

async function callTranslate(text, direction){
  text = String(text).trim().replace(/\s+/g,' ');
  if(!text) throw new Error('Teks kosong');

  var parts = text.split(/(?<=[.!?;])\s+/).filter(function(s){ return s.trim(); });
  if(parts.length<=1) parts = [text];
  if(parts.length>6) parts = parts.slice(0,6);

  var results = [];
  for(var i=0;i<parts.length;i++){
    var r = await translateOne(parts[i].trim(), direction);
    if(r) results.push(r);
  }
  if(!results.length) throw new Error('Tidak ada hasil');
  return cleanupTranslation(results.join(' '), direction);
}

async function translateOne(text, direction){
  var from = direction==='id2zh' ? 'id' : 'zh';
  var to = direction==='id2zh' ? 'zh' : 'id';

  try{
    var r1 = await fetchTimeout('https://lingva.ml/api/v1/'+from+'/'+to+'/'+encodeURIComponent(text), 10000);
    if(r1.ok){
      var d1 = await r1.json();
      var t1 = d1 && d1.translation && d1.translation.trim();
      if(t1 && !sameText(t1, text)){
        document.getElementById('trPv').textContent = 'Google · Lingva';
        return t1;
      }
    }
  }catch(e){}

  var lp = direction==='id2zh' ? 'id|zh-CN' : 'zh-CN|id';
  try{
    var r2 = await fetchTimeout('https://api.mymemory.translated.net/get?q='+encodeURIComponent(text)+'&langpair='+encodeURIComponent(lp), 15000);
    var d2 = await r2.json();
    var t2 = d2 && d2.responseData && d2.responseData.translatedText;
    if(t2 && !/MYMEMORY WARNING|QUERY LENGTH LIMIT|INVALID LANGUAGE|PLEASE SELECT/i.test(t2)){
      t2 = t2.trim();
      if(!sameText(t2, text)){
        document.getElementById('trPv').textContent = 'MyMemory';
        return t2;
      }
    }
    throw new Error('Terjemahan tidak berubah');
  }catch(e){
    if(e.name==='AbortError') throw new Error('Server timeout');
    throw e;
  }
}

function fetchTimeout(url, ms){
  var c = new AbortController();
  var t = setTimeout(function(){ c.abort(); }, ms);
  return fetch(url, { signal: c.signal }).finally(function(){ clearTimeout(t); });
}

function sameText(a, b){
  return String(a).toLowerCase().replace(/[\s\p{P}]/gu,'') === String(b).toLowerCase().replace(/[\s\p{P}]/gu,'');
}

function cleanupTranslation(text, direction){
  if(!text) return '';
  text = String(text).trim().replace(/\s+/g,' ');
  text = text.replace(/([.!?。！？])\1+/g, '$1');
  if(direction==='id2zh'){
    text = text.replace(/([\u4e00-\u9fff])\s+(?=[\u4e00-\u9fff])/g, '$1');
    text = text.replace(/([\u4e00-\u9fff])\s+([，。！？、；：])/g, '$1$2');
    text = text.replace(/([，。！？、；：])\s+/g, '$1');
  } else {
    text = text.replace(/\s+([.,!?;:])/g, '$1');
  }
  return text.trim();
}

function genPinyin(text){
  try{
    if(window.pinyinPro && typeof window.pinyinPro.pinyin==='function'){
      var py = window.pinyinPro.pinyin(text, { toneType:'symbol', type:'string', separator:' ' });
      return py.trim().replace(/\s+/g,' ');
    }
  }catch(e){}
  return '';
}


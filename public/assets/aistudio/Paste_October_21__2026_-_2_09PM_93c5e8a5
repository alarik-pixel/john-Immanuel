<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mandarin Pasti Bisa — 200 Halaman</title>
<script src="https://cdn.jsdelivr.net/npm/hanzi-writer@3/dist/hanzi-writer.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/pinyin-pro@3/dist/index.js"></script>
<style>
:root{--p:#c1272d;--pd:#8b1a1f;--g:#f4a300;--cr:#fdfaf5;--ink:#1a1a1a;--mu:#6b6b6b;--bd:#e8e0d5;--ok:#2d8f4f;--bl:#2b6cb0}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',system-ui,sans-serif;background:var(--cr);color:var(--ink);line-height:1.65}
.zh{font-family:'Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
.app{display:grid;grid-template-columns:280px 1fr;min-height:100vh}
@media(max-width:900px){.app{grid-template-columns:1fr}}
.sb{background:#fff;border-right:1px solid var(--bd);height:100vh;position:sticky;top:0;overflow-y:auto;display:flex;flex-direction:column;z-index:100}
.sb-h{padding:14px 16px;border-bottom:1px solid var(--bd);background:#fff;position:sticky;top:0;z-index:5}
.sb-b{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.sb-m{width:36px;height:36px;border-radius:9px;background:linear-gradient(135deg,var(--p),var(--pd));color:#fff;display:grid;place-items:center;font-weight:800;font-size:16px}
.sb-t strong{display:block;font-size:12.5px;line-height:1.2}
.sb-t small{color:var(--mu);font-size:10px;display:block;margin-top:2px}
.sb-a{font-size:10px;color:var(--g);font-weight:600;margin-top:3px}
.sb-p{font-size:11px;color:var(--mu);display:flex;justify-content:space-between;margin-top:6px}
.sb-bar{height:4px;background:#f0e8db;border-radius:99px;overflow:hidden;margin-top:4px}
.sb-fill{height:100%;background:linear-gradient(90deg,var(--p),var(--g));transition:width .5s;width:0}
.toc{padding:6px 0;flex:1}
.toc-ch{margin-bottom:1px}
.toc-h{display:flex;align-items:center;gap:10px;padding:8px 16px;cursor:pointer;user-select:none}
.toc-h:hover{background:#faf5ec}
.toc-h.on{background:#fdf4e6;border-left:3px solid var(--p);padding-left:13px}
.toc-n{width:24px;height:24px;border-radius:6px;background:var(--p);color:#fff;display:grid;place-items:center;font-weight:700;font-size:11px;flex-shrink:0}
.toc-i{flex:1;min-width:0}
.toc-i strong{font-size:12px;display:block;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.toc-i small{font-size:10px;color:var(--mu);display:block}
.toc-ps{display:none;padding:2px 0 6px;background:#fdfaf5}
.toc-ch.open .toc-ps{display:block}
.toc-pg{padding:5px 16px 5px 50px;font-size:11px;color:var(--mu);cursor:pointer;border-left:2px solid transparent;display:flex;justify-content:space-between;gap:6px}
.toc-pg:hover{background:#fff;color:var(--ink);border-left-color:var(--g)}
.toc-pg.on{background:#fff;color:var(--p);font-weight:600;border-left-color:var(--p)}
.toc-pg .pg{font-size:10px;color:#bbb}
.main{min-height:100vh;display:flex;flex-direction:column;min-width:0}
.tb{position:sticky;top:0;z-index:10;background:rgba(253,250,245,.95);backdrop-filter:blur(10px);border-bottom:1px solid var(--bd);padding:10px 18px;display:flex;align-items:center;gap:12px}
.hb{display:none;width:36px;height:36px;border-radius:9px;border:1px solid var(--bd);background:#fff;color:var(--ink);font-size:15px}
@media(max-width:900px){.hb{display:grid;place-items:center}}
.tb-t{flex:1;min-width:0}
.tb-t strong{font-size:13px;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tb-t small{color:var(--mu);font-size:11px}
.tb-a{display:flex;gap:5px}
.tb-b{padding:6px 10px;border-radius:8px;border:1px solid var(--bd);background:#fff;font-size:11.5px;color:var(--mu);font-weight:500}
.tb-b:hover{border-color:var(--p);color:var(--p)}
.tb-b.on{background:var(--p);color:#fff;border-color:var(--p)}
.tb-b.pri{background:var(--p);color:#fff;border-color:var(--p);font-weight:600}
.wrap{flex:1;padding:18px;max-width:960px;margin:0 auto;width:100%}
.page{background:#fff;border:1px solid var(--bd);border-radius:14px;padding:30px 34px;position:relative;min-height:500px;animation:fi .3s}
@media(max-width:640px){.page{padding:20px 16px}}
.page::before{content:"";position:absolute;top:0;left:0;width:100%;height:5px;background:linear-gradient(90deg,var(--p),var(--g))}
@keyframes fi{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.ph{margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid var(--bd)}
.pk{color:var(--p);font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.pt{font-size:clamp(19px,3vw,26px);font-weight:800;margin-top:4px;line-height:1.2}
.ps{color:var(--mu);font-size:13px;margin-top:6px}
.pb-b{position:absolute;top:14px;right:20px;font-size:11px;color:var(--mu);background:#fafaf7;padding:4px 10px;border-radius:99px;border:1px solid var(--bd)}
.cover{text-align:center;padding:16px 8px}
.cov-ic{font-size:80px;line-height:1;margin:8px 0 12px}
.cov-zh{font-size:52px;color:var(--p);font-weight:800;letter-spacing:5px;margin:6px 0 10px}
.cov-t{font-size:24px;font-weight:800;margin:8px 0}
.cov-s{color:var(--mu);font-size:14px;max-width:500px;margin:0 auto 16px}
.cov-g{text-align:left;background:#fafaf7;border-radius:12px;padding:16px;max-width:540px;margin:16px auto}
.cov-g h4{font-size:13px;margin-bottom:10px;color:var(--p)}
.cov-g ul{list-style:none}
.cov-g li{padding:4px 0;font-size:13px;display:flex;gap:8px}
.cov-g li::before{content:"✓";color:var(--ok);font-weight:700}
.cov-a{margin-top:20px;padding-top:14px;border-top:1px dashed var(--bd);font-size:12px;color:var(--mu)}
.cov-a strong{color:var(--p);font-size:13.5px}
.v-i{background:#fafaf7;border:1px solid var(--bd);border-radius:12px;padding:13px 15px;margin-bottom:10px;display:grid;grid-template-columns:1fr auto;gap:10px}
.v-hz{font-size:24px;font-weight:700;line-height:1.2;cursor:pointer}
.v-hz:hover{color:var(--p)}
.v-py{color:var(--p);font-size:12.5px;font-weight:500;margin-top:2px}
.v-id{font-size:14px;margin-top:4px;color:#333}
.v-ex{margin-top:8px;padding-top:8px;border-top:1px dashed var(--bd);font-size:12px;color:var(--mu)}
.v-ex-hz{color:var(--ink);font-size:14px;margin-bottom:2px;cursor:pointer}
.v-ex-hz:hover{color:var(--p)}
.v-btns{display:flex;flex-direction:column;gap:5px;align-items:flex-end}
.ib{width:32px;height:32px;border-radius:50%;border:1px solid var(--bd);background:#fff;color:var(--p);font-size:13px;display:grid;place-items:center}
.ib:hover{background:var(--p);color:#fff;border-color:var(--p)}
.g-c{background:#fff;border:1px solid var(--bd);border-left:4px solid var(--p);border-radius:11px;padding:16px 20px;margin-bottom:14px}
.g-c h4{font-size:15px;margin-bottom:9px}
.g-f{background:#fdf6ec;border-radius:8px;padding:9px 13px;font-family:'Courier New',monospace;font-size:13px;font-weight:600;color:var(--pd);margin-bottom:10px;border-left:3px solid var(--g)}
.g-d{font-size:13px;color:#333;margin-bottom:10px;line-height:1.6}
.g-ex{display:flex;gap:10px;align-items:center;padding:9px 11px;background:#fafaf7;border-radius:8px;margin-bottom:5px}
.g-ex-b{flex:1;min-width:0}
.g-ex-hz{font-size:15px;font-weight:500;cursor:pointer}
.g-ex-hz:hover{color:var(--p)}
.g-ex-py{font-size:12px;color:var(--p);margin:2px 0}
.g-ex-id{font-size:12px;color:var(--mu)}
.d-sc{background:linear-gradient(135deg,#fdf6ec,#fff);border:1px solid var(--bd);border-radius:12px;padding:14px;margin-bottom:14px;display:flex;gap:14px;align-items:center}
.d-ic{width:80px;height:80px;border-radius:50%;flex-shrink:0;background:#fff;display:grid;place-items:center;font-size:40px;box-shadow:0 6px 16px rgba(244,163,0,.18)}
.d-st{flex:1;min-width:0}
.d-st h4{font-size:14px;margin-bottom:3px}
.d-st p{font-size:12px;color:var(--mu)}
.dlg{display:flex;flex-direction:column;gap:10px}
.dl{display:flex;gap:10px;align-items:flex-start}
.dl.r{flex-direction:row-reverse}
.av{width:34px;height:34px;border-radius:50%;background:var(--p);color:#fff;display:grid;place-items:center;font-weight:700;font-size:13px;flex-shrink:0}
.dl.r .av{background:var(--g)}
.bub{background:#fff;border:1px solid var(--bd);border-radius:12px;padding:10px 14px;max-width:80%}
.dl.r .bub{background:#fdf6ec;border-color:#f0e0c0}
.bub-hz{font-size:16px;font-weight:500;cursor:pointer}
.bub-hz:hover{color:var(--p)}
.bub-py{font-size:12px;color:var(--p);margin:3px 0}
.bub-id{font-size:12px;color:var(--mu)}
.rd-h{background:linear-gradient(135deg,var(--p),var(--g));border-radius:12px;padding:20px 16px;text-align:center;color:#fff;margin-bottom:16px}
.rd-ic{font-size:58px;line-height:1}
.rd-zh{font-size:22px;font-weight:700;margin-top:6px;letter-spacing:2px}
.rd-t{background:#fafaf7;border-radius:11px;padding:16px;margin-bottom:12px;font-size:14.5px;line-height:2}
.rd-t .hz{cursor:pointer;padding:1px 2px;border-radius:4px}
.rd-t .hz:hover{background:#fdf4e6;color:var(--p)}
.rd-py{color:var(--p);font-size:12px;margin-top:8px;font-style:italic}
.rd-note{background:#f0f7ff;border-left:4px solid var(--bl);border-radius:9px;padding:12px 16px;font-size:13px;color:#1a365d;margin-top:10px}
.rd-note strong{display:block;margin-bottom:4px;color:var(--bl)}
.ex-g{background:#fafaf7;border-radius:11px;padding:16px;margin-bottom:12px}
.ex-g h4{font-size:13.5px;color:var(--p);margin-bottom:9px}
.ex-q{font-size:13.5px;margin-bottom:7px;padding-left:20px;position:relative;line-height:1.7}
.ex-q::before{content:"○";position:absolute;left:0;color:var(--mu)}
.ex-bl{display:inline-block;min-width:65px;border-bottom:1.5px dashed var(--p);color:var(--p);font-weight:600;text-align:center;padding:0 6px}
.qz-q{background:#fafaf7;border-radius:11px;padding:14px;margin-bottom:10px}
.qz-h{font-size:12px;color:var(--p);font-weight:700;margin-bottom:7px}
.qz-t{font-size:15px;font-weight:600;margin-bottom:9px}
.qz-zh{font-size:22px;color:var(--p);cursor:pointer;margin-bottom:5px}
.qz-zh:hover{text-decoration:underline}
.qz-o{display:grid;gap:7px;margin-top:9px}
.qz-b{padding:9px 13px;background:#fff;border:1px solid var(--bd);border-radius:8px;font-size:13.5px;text-align:left;color:var(--ink)}
.qz-b:hover{border-color:var(--p)}
.qz-b.correct{background:#e6f7ec;border-color:var(--ok);color:#1a5c2e;font-weight:600}
.qz-b.wrong{background:#fdeaea;border-color:var(--p);color:var(--p)}
.qz-b:disabled{cursor:default}
.qz-s{text-align:center;padding:18px;background:#fdf6ec;border-radius:12px;margin-top:14px}
.qz-s .n{font-size:34px;font-weight:800;color:var(--p)}
.qz-s p{color:var(--mu);font-size:13px;margin-top:4px}
.nav{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:14px 18px;max-width:960px;margin:0 auto;width:100%}
.nav-b{padding:10px 17px;border-radius:10px;border:1px solid var(--bd);background:#fff;font-size:13px;color:var(--ink);font-weight:600}
.nav-b:hover:not(:disabled){border-color:var(--p);color:var(--p)}
.nav-b.pri{background:var(--p);color:#fff;border-color:var(--p)}
.nav-b:disabled{opacity:.4;cursor:not-allowed}
.nav-i{font-size:12px;color:var(--mu)}
.st-g{display:grid;grid-template-columns:repeat(auto-fill,minmax(115px,1fr));gap:10px;margin-top:10px}
.st-i{background:#fafaf7;border:1px solid var(--bd);border-radius:11px;padding:9px;text-align:center}
.st-box{width:95px;height:95px;margin:0 auto;background:#fff;background-image:linear-gradient(to right,#f0e6d2 1px,transparent 1px),linear-gradient(to bottom,#f0e6d2 1px,transparent 1px);background-size:100% 100%;border:1px dashed #d8cdb9;border-radius:9px;position:relative;display:grid;place-items:center}
.st-box svg{position:relative;z-index:1}
.st-fb{font-size:56px;color:var(--p);font-weight:700}
.st-l{font-size:12.5px;margin-top:5px;font-weight:600}
.st-p{font-size:10.5px;color:var(--p)}
.st-b{display:flex;gap:4px;justify-content:center;margin-top:5px}
.st-b button{border:1px solid var(--bd);background:#fff;border-radius:5px;padding:2px 6px;font-size:10.5px;color:var(--mu)}
.st-b button:hover{color:var(--p);border-color:var(--p)}
.py-g{display:grid;grid-template-columns:repeat(auto-fill,minmax(85px,1fr));gap:7px;margin-top:8px}
.py-c{background:#fafaf7;border:1px solid var(--bd);border-radius:8px;padding:7px 5px;text-align:center;cursor:pointer}
.py-c:hover{background:#fff;border-color:var(--p)}
.py-c .p{font-size:15px;font-weight:700;color:var(--p)}
.py-c .e{font-size:10.5px;color:var(--mu);margin-top:2px}
.tone-g{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-top:10px}
.tone-c{background:linear-gradient(135deg,#fff,#fdf6ec);border:1px solid var(--bd);border-radius:12px;padding:14px;text-align:center;cursor:pointer}
.tone-c:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(0,0,0,.06)}
.tone-c .m{font-size:30px;color:var(--p);font-weight:700;line-height:1}
.tone-c .ex{font-size:24px;margin-top:5px}
.tone-c .expy{font-size:12px;color:var(--p);margin-top:2px}
.tone-c .nm{font-size:11px;color:var(--mu);margin-top:5px}
.tone-c .exid{font-size:11.5px;margin-top:3px;font-weight:600}
.rad-g{display:grid;grid-template-columns:repeat(auto-fill,minmax(105px,1fr));gap:9px;margin-top:10px}
.rad{background:#fafaf7;border:1px solid var(--bd);border-radius:9px;padding:11px;text-align:center;cursor:pointer}
.rad:hover{background:#fff;border-color:var(--p)}
.rad .rz{font-size:26px;font-weight:700;color:var(--p)}
.rad .rp{font-size:11px;color:var(--mu);margin-top:3px}
.rad .ri{font-size:12px;font-weight:600;margin-top:3px}
.rad .re{font-size:10px;color:var(--mu);margin-top:3px}
.rules{display:grid;gap:9px;margin-top:10px}
.rule{display:flex;gap:11px;padding:12px;background:#fafaf7;border-radius:11px;border:1px solid var(--bd)}
.rule-n{width:26px;height:26px;border-radius:7px;background:var(--p);color:#fff;display:grid;place-items:center;font-weight:700;font-size:13px;flex-shrink:0}
.rule-b strong{display:block;font-size:13px;margin-bottom:2px}
.rule-b p{font-size:12px;color:var(--mu);line-height:1.5}
.rule-b .demo{font-size:18px;color:var(--p);margin-top:5px;font-weight:600}
.ic{background:#fff;border:1px solid var(--bd);border-radius:12px;padding:16px;margin-bottom:12px}
.ic h3{font-size:15px;margin-bottom:9px;display:flex;align-items:center;gap:8px}
.ic h3::before{content:"";width:4px;height:16px;background:var(--p);border-radius:2px}
.ic p.d{font-size:13px;color:#333;margin-bottom:10px;line-height:1.6}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:99;display:none}
.ov.on{display:block}
@media(max-width:900px){.sb{position:fixed;left:0;top:0;width:270px;transform:translateX(-100%);transition:.3s}.sb.open{transform:translateX(0)}}
.sn{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(120%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:10px;font-size:12.5px;z-index:400;transition:.35s;white-space:nowrap;max-width:90%;overflow:hidden;text-overflow:ellipsis}
.sn.on{transform:translateX(-50%) translateY(0)}
.foot{text-align:center;padding:26px 18px;color:var(--mu);font-size:11.5px;border-top:1px solid var(--bd);margin-top:16px}
.foot strong{color:var(--p)}

/* TRANSLATOR — PUTIH BERSIH */
.tr-ov{position:fixed;inset:0;background:rgba(0,0,0,.35);backdrop-filter:blur(4px);z-index:300;display:none;align-items:center;justify-content:center;padding:16px}
.tr-ov.on{display:flex}
.tr-d{background:#fff;border-radius:18px;width:100%;max-width:920px;max-height:94vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 25px 80px rgba(0,0,0,.25)}
.tr-h{padding:14px 18px;display:flex;align-items:center;gap:11px;background:#fff;color:var(--ink);border-bottom:1px solid var(--bd)}
.tr-h-ic{width:38px;height:38px;border-radius:10px;background:#fdf6ec;color:var(--p);display:grid;place-items:center;font-size:19px;flex-shrink:0;border:1px solid var(--bd)}
.tr-h-t{flex:1;min-width:0}
.tr-h-t h3{font-size:15px;font-weight:700;margin-bottom:2px;color:var(--ink)}
.tr-h-t p{font-size:11px;color:var(--mu)}
.tr-c{width:36px;height:36px;border-radius:50%;background:#fff;color:var(--mu);font-size:17px;border:1px solid var(--bd);display:grid;place-items:center}
.tr-c:hover{background:#fdf6ec;color:var(--p);border-color:var(--p)}
.tr-l{padding:11px 18px;display:flex;align-items:center;gap:10px;background:#fff;border-bottom:1px solid var(--bd);flex-wrap:wrap}
.tr-pl{padding:7px 14px;background:#fff;border:1px solid var(--bd);border-radius:99px;font-size:13px;font-weight:600;color:var(--ink)}
.tr-pl.on{background:var(--p);color:#fff;border-color:var(--p)}
.tr-sw{width:34px;height:34px;border-radius:50%;border:1px solid var(--bd);background:#fff;color:var(--p);font-size:15px;transition:.3s;display:grid;place-items:center}
.tr-sw:hover{background:#fdf6ec;transform:rotate(180deg)}
.tr-b{display:grid;grid-template-columns:1fr 1fr;flex:1;overflow:hidden;min-height:0;background:#fff}
@media(max-width:720px){.tr-b{grid-template-columns:1fr}}
.tr-p{padding:14px 16px;display:flex;flex-direction:column;min-height:260px;overflow-y:auto;background:#fff}
.tr-p:first-child{border-right:1px solid var(--bd)}
@media(max-width:720px){.tr-p:first-child{border-right:none;border-bottom:1px solid var(--bd)}}
.tr-lb{font-size:11px;font-weight:700;color:var(--mu);text-transform:uppercase;letter-spacing:.05em;margin-bottom:7px}
.tr-in{width:100%;flex:1;min-height:150px;resize:none;border:none;outline:none;font-family:inherit;font-size:15px;line-height:1.6;color:var(--ink);background:#fff}
.tr-in::placeholder{color:#bbb}
.tr-if{display:flex;justify-content:space-between;align-items:center;margin-top:8px;padding-top:8px;border-top:1px solid var(--bd);font-size:11px;color:var(--mu)}
.tr-acts{display:flex;gap:4px}
.tr-ab{width:34px;height:34px;border-radius:50%;border:1px solid var(--bd);background:#fff;color:var(--mu);font-size:14px;display:grid;place-items:center}
.tr-ab:hover{background:#fdf6ec;color:var(--p);border-color:var(--p)}
.tr-ab.rec{background:var(--p);color:#fff;border-color:var(--p)}
.tr-em{color:var(--mu);font-size:13px;padding:18px 0;text-align:center;font-style:italic;background:#fff}
.tr-blk{margin-bottom:14px}
.tr-bl{font-size:10.5px;font-weight:700;color:var(--p);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px}
.tr-zh{font-size:26px;font-weight:700;line-height:1.35;padding:10px 12px;background:#fff;border-radius:9px;border:1px solid var(--bd);border-left:3px solid var(--p);cursor:pointer}
.tr-zh:hover{background:#fdf6ec}
.tr-py{font-size:13.5px;color:var(--p);margin-top:5px;font-style:italic;padding-left:12px}
.tr-id{font-size:15.5px;line-height:1.6;padding:10px 12px;background:#fff;border-radius:9px;border:1px solid var(--bd);border-left:3px solid var(--bl)}
.tr-ba{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}

  var score = 0;
  for(var i=0;i<total;i++) if(!document.querySelector('.qz-b[data-q="'+i+'"].wrong')) score++;
  document.getElementById('qzS').style.display = 'block';
  document.getElementById('qzN').textContent = score+'/'+total;
  document.getElementById('qzM').textContent = score>=Math.ceil(total*0.8) ? '🎉 Luar biasa! Anda lulus bab ini.' : '💪 Coba lagi untuk skor lebih baik.';

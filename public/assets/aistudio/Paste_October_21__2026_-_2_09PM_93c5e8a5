/* ============ BUILD BOOK ============ */
var BOOK = [];
for(var ci=0;ci<CH.length;ci++){
  var ch = CH[ci];
  var pages = [];
  if(ch.special){
    pages = ch.special;
  } else {
    pages = [
      {type:'cover',zh:ch.zh,title:ch.title,sub:ch.title,goals:ch.goals},
      {type:'vocab',title:ch.v1.title,sub:'Kosakata bagian 1.',words:ch.v1.words},
      {type:'vocab',title:ch.v2.title,sub:'Kosakata bagian 2.',words:ch.v2.words},
      {type:'grammar',title:ch.g1.title,sub:'Pola grammar penting.',items:ch.g1.items},
      {type:'grammar',title:ch.g2.title,sub:'Pola grammar lanjutan.',items:ch.g2.items},
      {type:'dialog',title:'Dialog: '+ch.d1.title,icon:ch.d1.icon,sceneTitle:ch.d1.sceneTitle,sceneDesc:ch.d1.sceneDesc,lines:ch.d1.lines},
      {type:'dialog',title:'Dialog: '+ch.d2.title,icon:ch.d2.icon,sceneTitle:ch.d2.sceneTitle,sceneDesc:ch.d2.sceneDesc,lines:ch.d2.lines},
      {type:'reading',title:'Budaya: '+ch.rd.title,zh:ch.rd.zh,icon:ch.rd.icon,text:ch.rd.text,py:ch.rd.py,id:ch.rd.id,note:ch.rd.note},
      {type:'exercise',title:'Latihan Bab '+ch.num,sub:'Latihan menyeluruh.',groups:ch.ex.groups},
      {type:'quiz',title:'Kuis Bab '+ch.num,sub:'Skor ≥80% lulus.',qs:ch.qz}
    ];
  }
  for(var pi=0;pi<pages.length;pi++){
    var pg = pages[pi];
    pg.chapterNum = ch.num;
    pg.chapterTitle = ch.title;
    pg.chapterIcon = ch.icon;
    pg.pageInChapter = pi + 1;
    pg.totalInChapter = pages.length;
    BOOK.push(pg);
  }
}
var TOTAL = BOOK.length;
var currentPage = 1;
var quizState = {};

/* ============ NAVIGATION ============ */
function goPage(n){
  if(n<1||n>TOTAL) return;
  currentPage = n;
  quizState = {};
  renderPage();
  updateNav();
  updateProgress();
  window.scrollTo({top:0,behavior:'smooth'});
  if(avOn){ var el = document.querySelector('#pg .zh'); if(el) setTimeout(function(){ speak(el.textContent.trim()); },400); }
}
function nextPg(){ if(currentPage<TOTAL) goPage(currentPage+1); }
function prevPg(){ if(currentPage>1) goPage(currentPage-1); }

function updateNav(){
  document.getElementById('pvB').disabled = currentPage<=1;
  document.getElementById('nxB').disabled = currentPage>=TOTAL;
  document.getElementById('navI').textContent = currentPage+' / '+TOTAL;
  var pg = BOOK[currentPage-1];
  if(!pg) return;
  document.getElementById('tbT').textContent = 'Bab '+pg.chapterNum+': '+pg.chapterTitle;
  document.getElementById('tbS').textContent = 'Hal. '+pg.pageInChapter+'/'+pg.totalInChapter+' · '+(pg.title||'');
  document.getElementById('sbTx').textContent = 'Halaman '+currentPage+' dari '+TOTAL;
  var tp = document.querySelectorAll('.toc-pg');
  for(var i=0;i<tp.length;i++) tp[i].classList.toggle('on', parseInt(tp[i].getAttribute('data-page'))===currentPage);
  var th = document.querySelectorAll('.toc-h');
  for(var j=0;j<th.length;j++) th[j].classList.toggle('on', parseInt(th[j].getAttribute('data-ch'))===pg.chapterNum);
  var ac = document.querySelector('.toc-ch[data-ch="'+pg.chapterNum+'"]');
  if(ac) ac.classList.add('open');
  var ap = document.querySelector('.toc-pg.on');
  if(ap) setTimeout(function(){ ap.scrollIntoView({block:'nearest',behavior:'smooth'}); },100);
}

function updateProgress(){
  var pct = Math.round((currentPage/TOTAL)*100);
  document.getElementById('sbFl').style.width = pct+'%';
  document.getElementById('sbPc').textContent = pct+'%';
  try{ localStorage.setItem('mandarin_page', String(currentPage)); }catch(e){}
}

/* ============ RENDER ============ */
function renderPage(){
  var pg = BOOK[currentPage-1];
  if(!pg) return;
  var html = '';
  switch(pg.type){
    case 'cover': html = renderCover(pg); break;
    case 'vocab': html = pageHead(pg) + renderVocab(pg); break;
    case 'grammar': html = pageHead(pg) + renderGrammar(pg); break;
    case 'dialog': html = pageHead(pg) + renderDialog(pg); break;
    case 'reading': html = pageHead(pg) + renderReading(pg); break;
    case 'exercise': html = pageHead(pg) + renderExercise(pg); break;
    case 'quiz': html = pageHead(pg) + renderQuiz(pg); break;
    case 'pinyin': html = pageHead(pg) + renderPinyin(); break;
    case 'tones': html = pageHead(pg) + renderTones(); break;
    case 'radicals': html = pageHead(pg) + renderRadicals(); break;
    case 'strokes': html = pageHead(pg) + renderStrokes(); break;
    default: html = pageHead(pg) + '<p>Tipe halaman tidak dikenal.</p>';
  }
  document.getElementById('pg').innerHTML = html;
  if(pg.type==='strokes') setTimeout(initStrokes,200);
}

function pageHead(pg){
  return '<div class="pb-b">Hal. '+currentPage+' / '+TOTAL+'</div>' +
    '<div class="ph"><div class="pk">Bab '+pg.chapterNum+' · Halaman '+pg.pageInChapter+'/'+pg.totalInChapter+'</div>' +
    '<h1 class="pt">'+(pg.title||'')+'</h1>' +
    (pg.sub?'<p class="ps">'+pg.sub+'</p>':'') + '</div>';
}

function renderCover(pg){
  var ch = null;
  for(var i=0;i<CH.length;i++) if(CH[i].num===pg.chapterNum){ ch=CH[i]; break; }
  var icon = ch ? ch.icon : '📖';
  var g = '';
  if(pg.goals){
    g = '<div class="cov-g"><h4>📌 Tujuan Pembelajaran</h4><ul>';
    for(var j=0;j<pg.goals.length;j++) g += '<li>'+pg.goals[j]+'</li>';
    g += '</ul></div>';
  }
  return '<div class="cover"><div class="cov-ic">'+icon+'</div>' +
    '<div class="cov-zh zh">'+(pg.zh||'')+'</div>' +
    '<h1 class="cov-t">'+(pg.title||'')+'</h1>' +
    '<p class="cov-s">'+(pg.sub||'')+'</p>' + g +
    '<div class="cov-a"><strong>'+AUTHOR+'</strong><br><span style="font-size:11px">Penulis Buku Mandarin Pasti Bisa</span></div></div>';
}

function renderVocab(pg){
  if(!pg.words) return '';
  var h = '<div>';
  for(var i=0;i<pg.words.length;i++){
    var v = pg.words[i];
    h += '<div class="v-i"><div><div class="v-hz zh" onclick="speak(\''+esc(v.h)+'\')">'+v.h+'</div>' +
      '<div class="v-py">'+v.p+'</div><div class="v-id">'+v.i+'</div>';
    if(v.e) h += '<div class="v-ex"><div class="v-ex-hz zh" onclick="speak(\''+esc(v.e)+'\')">'+v.e+'</div><div>'+(v.ei||'')+'</div></div>';
    h += '</div><div class="v-btns"><button class="ib" onclick="speak(\''+esc(v.h)+'\')">🔊</button>' +
      (v.e?'<button class="ib" onclick="speak(\''+esc(v.e)+'\')">📢</button>':'') + '</div></div>';
  }
  return h + '</div>';
}

function renderGrammar(pg){
  if(!pg.items) return '';
  var h = '';
  for(var i=0;i<pg.items.length;i++){
    var g = pg.items[i];
